# Generate a random 32-byte secret before running. Never commit real secrets.
RALLY_SECRET=

ADMIN_PASSWORD=

# libSQL connection. `file:local.db` keeps a SQLite file in the project root for
# local work; point at libsql://<db>.turso.io and set a token for Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
