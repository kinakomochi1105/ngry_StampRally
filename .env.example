# Generate a random 32-byte secret before running. Never commit real secrets.
RALLY_SECRET=

ADMIN_PASSWORD=

# Public address printed into the QR links, e.g. https://rally.example.jp.
# Leave empty to use the address the admin screen is opened on.
RALLY_SITE_URL=

# The festival every row, cookie and QR signature belongs to (lowercase
# letters, digits, hyphens). Leave empty to keep the original `festival-2026`.
# Set a new one for next year's festival; changing it mid-festival invalidates
# every printed QR code and every participant's pass.
RALLY_EVENT_ID=

# Key (32 bytes) and IV (16 bytes) that Config/forbidden was encrypted with in
# EncryptorTool — the values in its config.toml. Registration refuses every
# nickname until both are set.
NICKNAME_BLOCKLIST_KEY=
NICKNAME_BLOCKLIST_IV=

# libSQL connection. `file:local.db` keeps a SQLite file in the project root for
# local work; point at libsql://<db>.turso.io and set a token for Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Set to 1 to answer every participant page and API with 503 "under
# maintenance". The organiser console (/admin) stays available. On Vercel,
# changing it takes effect with the next deployment.
MAINTENANCE_MODE=

# Vercel preview deployments skip migrations so an unmerged branch never
# changes the production schema. Set to 1 only on a preview with its own database.
MIGRATE_PREVIEW_DATABASE=
