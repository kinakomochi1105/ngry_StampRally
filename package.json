{
  "name": "ngry-stamp-rally",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build && node scripts/db-migrate.mjs --if-configured",
    "start": "next start -H 0.0.0.0",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:manual",
    "test:unit": "node --import ./tests/support/register.mjs --test \"tests/unit/*.test.mjs\"",
    "test:manual": "node --import ./tests/support/register.mjs tests/manual.mjs",
    "test:api": "node --env-file-if-exists=.env --import ./tests/support/register.mjs tests/api.mjs",
    "test:i18n": "node --import ./tests/support/register.mjs tests/i18n.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "node scripts/db-migrate.mjs",
    "dev:https": "node scripts/dev-https.mjs",
    "setup:https": "node scripts/setup-https.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "jsbarcode": "3.12.3",
    "jsqr": "^1.4.0",
    "lucide-react": "1.31.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
